---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { portfolio } from '../data/portfolio';
---
<BaseLayout title={`Resume — ${portfolio.name}`} description={`Read or download ${portfolio.name}'s Resume.`}>
  <section class="container cv-page" aria-labelledby="cv-title">
    <div class="cv-heading">
      <div><h1 id="cv-title">Resume</h1><p>{portfolio.name}</p></div>
      <div class="cv-actions">
        <a class="button button-dark" href={portfolio.cv} download>Download Resume <Icon name="download" /></a>
      </div>
    </div>
    <p class="cv-help">If the preview does not appear, select Download Resume.</p>
    <object class="cv-document" data={portfolio.cv} type="application/pdf" aria-label={`Resume for ${portfolio.name}`}>
      <div class="cv-fallback">
        <p>Your browser cannot display this PDF here.</p>
        <a class="text-link" href={portfolio.cv}>Open the Resume as a PDF <Icon name="external" /></a>
      </div>
    </object>
  </section>
</BaseLayout>

<style>
  .cv-page { padding-block: 48px 64px; }
  .cv-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px; }
  h1 { font-size: clamp(2.5rem, 5vw, 4rem); }
  .cv-heading p { margin-top: 12px; color: var(--muted); }
  .cv-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .cv-help { margin-block: 24px 16px; font-size: .875rem; color: var(--muted); }
  .cv-document { display: block; width: 100%; height: 80vh; height: 80dvh; min-height: 400px; border: 1px solid var(--line); border-radius: 7px; background: var(--white); }
  .cv-fallback { padding: 24px; }
  .cv-fallback p { margin-bottom: 16px; }
  @media (max-width: 760px) {
    .cv-page { padding-block: 32px; }
    .cv-actions { width: 100%; }
    .cv-actions .button { flex: 1; }
  }
</style>
